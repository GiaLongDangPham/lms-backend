    "responses": {
      "NoContent": { "description": "Completed with no response body" },
      "LoginOk": { "description": "Signed in; token form is provisional", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResult" } } } },
      "UserOk": { "description": "Account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
      "UserCreated": { "description": "Account created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
      "UsersOk": { "description": "Accounts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserPage" } } } },
      "ClassOk": { "description": "Class", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Class" } } } },
      "ClassCreated": { "description": "Class created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Class" } } } },
      "ClassesOk": { "description": "Classes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClassPage" } } } },
      "TeacherAssignmentCreated": { "description": "Teacher assigned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeacherAssignment" } } } },
      "EnrollmentCreated": { "description": "Student enrolled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Enrollment" } } } },
      "EnrollmentsOk": { "description": "Enrollments", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EnrollmentPage" } } } },
      "FileCreated": { "description": "Private file uploaded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/File" } } } },
      "MaterialOk": { "description": "Material", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Material" } } } },
      "MaterialCreated": { "description": "Material created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Material" } } } },
      "MaterialsOk": { "description": "Materials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MaterialPage" } } } },
      "AssignmentOk": { "description": "Assignment", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Assignment" } } } },
      "AssignmentCreated": { "description": "Assignment created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Assignment" } } } },
      "AssignmentsOk": { "description": "Assignments", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignmentPage" } } } },
      "SubmissionOk": { "description": "Submission with version history; no grade", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Submission" } } } },
      "SubmissionCreated": { "description": "Version created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Submission" } } } },
      "SubmissionsOk": { "description": "Submissions without grades", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionPage" } } } },
      "GradeOk": { "description": "Teacher-only grade, possibly Draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Grade" } } } },
      "PublishedGradeOk": { "description": "Published grade only", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublishedGrade" } } } },
      "NotificationsOk": { "description": "Caller notifications", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPage" } } } },
      "NotificationOk": { "description": "Owned notification", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Notification" } } } },
      "CommentsOk": { "description": "Visible comments", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentPage" } } } },
      "CommentCreated": { "description": "Comment created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Comment" } } } },
      "SubmissionCommentsOk": { "description": "Visible submission comments", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionCommentPage" } } } },
      "SubmissionCommentCreated": { "description": "Submission comment created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionComment" } } } },
      "BadRequest": { "description": "Invalid input or JSON", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "VALIDATION_ERROR", "message": "Request is invalid." } } } } },
      "Unauthorized": { "description": "Missing or invalid login", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "UNAUTHORIZED", "message": "Authentication is required." } } } } },
      "Forbidden": { "description": "Role or class rights denied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "FORBIDDEN", "message": "Access is denied." } } } } },
      "NotFound": { "description": "Unknown or intentionally hidden resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "NOT_FOUND", "message": "Resource not found." } } } } },
      "Conflict": { "description": "Duplicate or state conflict; policy-specific cases pending review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "CONFLICT", "message": "Operation conflicts with current state." } } } } },
      "PayloadTooLarge": { "description": "Upload exceeds configured limit", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "PAYLOAD_TOO_LARGE", "message": "File exceeds the upload limit." } } } } },
      "UnsupportedMediaType": { "description": "Unsupported file type", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "UNSUPPORTED_FILE_TYPE", "message": "File type is not supported." } } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000004" },
      "Timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp with offset; responses use UTC", "example": "2026-10-20T09:00:00Z" },
      "Role": { "type": "string", "enum": ["ADMIN", "TEACHER", "STUDENT"], "example": "STUDENT" },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "PageInfo": { "type": "object", "required": ["nextCursor"], "properties": { "nextCursor": { "type": ["string", "null"], "description": "Null when there is no next page", "example": null } } },
      "LoginRequest": { "type": "object", "required": ["schoolCode", "password"], "properties": { "schoolCode": { "type": "string", "example": "SV001" }, "password": { "type": "string", "format": "password", "writeOnly": true, "example": "local-demo-password" } } },
      "LoginResult": { "type": "object", "required": ["accessToken", "user"], "properties": { "accessToken": { "type": "string", "example": "mock-token-not-a-real-credential" }, "user": { "$ref": "#/components/schemas/User" } }, "description": "Provisional bearer response until B1 auth choice is approved" },
      "User": { "type": "object", "required": ["id", "schoolCode", "fullName", "role", "isActive", "createdAt"], "properties": { "id": { "$ref": "#/components/schemas/Uuid" }, "schoolCode": { "type": "string", "example": "SV001" }, "fullName": { "type": "string", "example": "Sinh viên Demo 1" }, "email": { "type": ["string", "null"], "format": "email", "example": "sv001@example.invalid" }, "role": { "$ref": "#/components/schemas/Role" }, "isActive": { "type": "boolean", "example": true }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "CreateUserRequest": { "type": "object", "required": ["schoolCode", "fullName", "role"], "properties": { "schoolCode": { "type": "string", "example": "SV004" }, "fullName": { "type": "string", "example": "Sinh viên Demo 4" }, "email": { "type": ["string", "null"], "format": "email", "example": "sv004@example.invalid" }, "role": { "$ref": "#/components/schemas/Role" } }, "description": "Credential issuance is pending CP1; no password is returned" },
      "Class": { "type": "object", "required": ["id", "code", "name", "term", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "20000000-0000-4000-8000-000000000001" }, "code": { "type": "string", "example": "LMS-DEMO-A" }, "name": { "type": "string", "example": "Lớp Demo A" }, "term": { "type": "string", "example": "2026-HK1" }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "CreateClassRequest": { "type": "object", "required": ["code", "name", "term"], "properties": { "code": { "type": "string", "example": "LMS-DEMO-A" }, "name": { "type": "string", "example": "Lớp Demo A" }, "term": { "type": "string", "example": "2026-HK1" } } },
      "AssignTeacherRequest": { "type": "object", "required": ["teacherId"], "properties": { "teacherId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000002" } } },
      "TeacherAssignment": { "type": "object", "required": ["classId", "teacherId", "assignedAt"], "properties": { "classId": { "type": "string", "format": "uuid", "example": "20000000-0000-4000-8000-000000000001" }, "teacherId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000002" }, "assignedAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "EnrollStudentRequest": { "type": "object", "required": ["studentId"], "properties": { "studentId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000004" } } },
      "Enrollment": { "type": "object", "required": ["id", "classId", "studentId", "isActive", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "30000000-0000-4000-8000-000000000001" }, "classId": { "type": "string", "format": "uuid", "example": "20000000-0000-4000-8000-000000000001" }, "studentId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000004" }, "isActive": { "type": "boolean", "example": true }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "File": { "type": "object", "required": ["id", "originalName", "mimeType", "sizeBytes", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "70000000-0000-4000-8000-000000000003" }, "originalName": { "type": "string", "example": "answer.pdf" }, "mimeType": { "type": "string", "example": "application/pdf" }, "sizeBytes": { "type": "integer", "minimum": 1, "example": 128 }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } }, "description": "Never expose storage provider, container or object key" },
      "Material": { "type": "object", "required": ["id", "classId", "title", "files", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "40000000-0000-4000-8000-000000000001" }, "classId": { "type": "string", "format": "uuid", "example": "20000000-0000-4000-8000-000000000001" }, "title": { "type": "string", "example": "Tài liệu mẫu lớp A" }, "description": { "type": ["string", "null"], "example": "Tuần 1" }, "files": { "type": "array", "items": { "$ref": "#/components/schemas/File" } }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "CreateMaterialRequest": { "type": "object", "required": ["title", "fileIds"], "properties": { "title": { "type": "string", "example": "Tài liệu mẫu lớp A" }, "description": { "type": ["string", "null"], "example": "Tuần 1" }, "fileIds": { "type": "array", "items": { "$ref": "#/components/schemas/Uuid" }, "example": ["70000000-0000-4000-8000-000000000001"] } } },
      "UpdateMaterialRequest": { "type": "object", "minProperties": 1, "properties": { "title": { "type": "string", "example": "Tài liệu đã cập nhật" }, "description": { "type": ["string", "null"], "example": "Tuần 1" }, "fileIds": { "type": "array", "items": { "$ref": "#/components/schemas/Uuid" } } } },
      "Assignment": { "type": "object", "required": ["id", "classId", "title", "deadlineAt", "maxScore", "files", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "50000000-0000-4000-8000-000000000001" }, "classId": { "type": "string", "format": "uuid", "example": "20000000-0000-4000-8000-000000000001" }, "title": { "type": "string", "example": "Bài mẫu có lịch sử nộp" }, "description": { "type": ["string", "null"], "example": "Nộp PDF" }, "deadlineAt": { "type": "string", "format": "date-time", "example": "2026-10-27T10:00:00Z" }, "maxScore": { "type": "number", "exclusiveMinimum": 0, "example": 10 }, "files": { "type": "array", "items": { "$ref": "#/components/schemas/File" } }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "CreateAssignmentRequest": { "type": "object", "required": ["title", "deadlineAt", "maxScore"], "properties": { "title": { "type": "string", "example": "Bài mẫu có lịch sử nộp" }, "description": { "type": ["string", "null"], "example": "Nộp PDF" }, "deadlineAt": { "type": "string", "format": "date-time", "example": "2026-10-27T10:00:00Z" }, "maxScore": { "type": "number", "exclusiveMinimum": 0, "example": 10 }, "fileIds": { "type": "array", "items": { "$ref": "#/components/schemas/Uuid" }, "example": [] } } },
      "UpdateAssignmentRequest": { "type": "object", "minProperties": 1, "properties": { "title": { "type": "string", "example": "Bài tập đã sửa" }, "description": { "type": ["string", "null"], "example": "Nộp PDF" }, "deadlineAt": { "type": "string", "format": "date-time", "example": "2026-10-28T10:00:00Z" }, "maxScore": { "type": "number", "exclusiveMinimum": 0, "example": 10 }, "fileIds": { "type": "array", "items": { "$ref": "#/components/schemas/Uuid" } } } },
      "SubmitAssignmentRequest": { "type": "object", "required": ["fileIds"], "properties": { "fileIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Uuid" }, "example": ["70000000-0000-4000-8000-000000000003"] } }, "description": "Actor and server time come from auth/server, never from the request; all files and version commit atomically" },
      "SubmissionVersion": { "type": "object", "required": ["versionNumber", "submittedAt", "deadlineAtSubmission", "isLate", "files"], "properties": { "versionNumber": { "type": "integer", "minimum": 1, "example": 2 }, "submittedAt": { "type": "string", "format": "date-time", "example": "2026-10-20T10:00:00Z" }, "deadlineAtSubmission": { "type": "string", "format": "date-time", "example": "2026-10-27T10:00:00Z" }, "isLate": { "type": "boolean", "example": false }, "files": { "type": "array", "items": { "$ref": "#/components/schemas/File" } } } },
      "Submission": { "type": "object", "required": ["id", "assignmentId", "studentId", "currentVersionNumber", "versions", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "60000000-0000-4000-8000-000000000001" }, "assignmentId": { "type": "string", "format": "uuid", "example": "50000000-0000-4000-8000-000000000001" }, "studentId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000004" }, "currentVersionNumber": { "type": "integer", "minimum": 1, "example": 2 }, "versions": { "type": "array", "items": { "$ref": "#/components/schemas/SubmissionVersion" }, "example": [{ "versionNumber": 1, "submittedAt": "2026-10-20T09:00:00Z", "deadlineAtSubmission": "2026-10-27T10:00:00Z", "isLate": false, "files": [{ "id": "70000000-0000-4000-8000-000000000003", "originalName": "first.pdf", "mimeType": "application/pdf", "sizeBytes": 128, "createdAt": "2026-10-20T09:00:00Z" }] }, { "versionNumber": 2, "submittedAt": "2026-10-20T10:00:00Z", "deadlineAtSubmission": "2026-10-27T10:00:00Z", "isLate": false, "files": [{ "id": "70000000-0000-4000-8000-000000000005", "originalName": "revised.pdf", "mimeType": "application/pdf", "sizeBytes": 128, "createdAt": "2026-10-20T10:00:00Z" }] }] }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } }, "description": "One submission record per student and assignment; versions are immutable; no grade fields" },
      "SaveDraftGradeRequest": { "type": "object", "required": ["gradedVersionNumber", "score"], "properties": { "gradedVersionNumber": { "type": "integer", "minimum": 1, "example": 2 }, "score": { "type": "number", "minimum": 0, "example": 8.5 }, "feedback": { "type": ["string", "null"], "example": "Cần bổ sung nguồn tham khảo" } }, "description": "Score must not exceed assignment maxScore; grade version must belong to the submission" },
      "Grade": { "type": "object", "required": ["submissionId", "gradedVersionNumber", "score", "status", "gradedAt"], "properties": { "submissionId": { "type": "string", "format": "uuid", "example": "60000000-0000-4000-8000-000000000001" }, "gradedVersionNumber": { "type": "integer", "minimum": 1, "example": 2 }, "score": { "type": "number", "minimum": 0, "example": 8.5 }, "feedback": { "type": ["string", "null"], "example": "Cần bổ sung nguồn tham khảo" }, "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED"], "example": "DRAFT" }, "gradedAt": { "$ref": "#/components/schemas/Timestamp" }, "publishedAt": { "type": ["string", "null"], "format": "date-time", "example": null } }, "description": "Teacher-only representation; never reuse for student endpoints" },
      "PublishedGrade": { "type": "object", "required": ["submissionId", "gradedVersionNumber", "score", "status", "publishedAt"], "properties": { "submissionId": { "type": "string", "format": "uuid", "example": "60000000-0000-4000-8000-000000000002" }, "gradedVersionNumber": { "type": "integer", "minimum": 1, "example": 1 }, "score": { "type": "number", "minimum": 0, "example": 9 }, "feedback": { "type": ["string", "null"], "example": "Làm tốt" }, "status": { "type": "string", "const": "PUBLISHED", "example": "PUBLISHED" }, "publishedAt": { "type": "string", "format": "date-time", "example": "2026-10-20T11:00:00Z" } } },
      "Notification": { "type": "object", "required": ["id", "kind", "title", "body", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "80000000-0000-4000-8000-000000000001" }, "kind": { "type": "string", "enum": ["ASSIGNMENT_CREATED", "DEADLINE_REMINDER", "GRADE_PUBLISHED"], "example": "ASSIGNMENT_CREATED" }, "assignmentId": { "type": ["string", "null"], "format": "uuid", "example": "50000000-0000-4000-8000-000000000001" }, "title": { "type": "string", "example": "Bài tập mẫu mới" }, "body": { "type": "string", "example": "Có bài tập mẫu trong lớp A." }, "readAt": { "type": ["string", "null"], "format": "date-time", "example": null }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } }, "description": "Do not embed grade score or Draft feedback" },
      "Comment": { "type": "object", "required": ["id", "authorId", "body", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid", "example": "90000000-0000-4000-8000-000000000001" }, "authorId": { "type": "string", "format": "uuid", "example": "10000000-0000-4000-8000-000000000004" }, "assignmentId": { "type": ["string", "null"], "format": "uuid", "example": "50000000-0000-4000-8000-000000000001" }, "submissionId": { "type": ["string", "null"], "format": "uuid", "example": null }, "body": { "type": "string", "example": "Em có thể nộp hai file không ạ?" }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } }, "description": "Exactly one target is set; flat comments only" },
      "SubmissionComment": { "allOf": [{ "$ref": "#/components/schemas/Comment" }], "example": { "id": "90000000-0000-4000-8000-000000000002", "authorId": "10000000-0000-4000-8000-000000000003", "assignmentId": null, "submissionId": "60000000-0000-4000-8000-000000000002", "body": "Phản hồi mẫu trên bài nộp", "createdAt": "2026-10-20T09:00:00Z" } },
      "CreateCommentRequest": { "type": "object", "required": ["body"], "properties": { "body": { "type": "string", "minLength": 1, "example": "Em có thể nộp hai file không ạ?" } } },
      "UserPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "ClassPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Class" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "EnrollmentPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Enrollment" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "MaterialPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Material" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "AssignmentPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Assignment" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "SubmissionPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Submission" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "NotificationPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "CommentPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } },
      "SubmissionCommentPage": { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/SubmissionComment" } }, "page": { "$ref": "#/components/schemas/PageInfo" } } }
    }
  }
}
