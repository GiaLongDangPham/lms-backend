NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:15432/lms
DATABASE_SSL=false
# Migration 0003: only needed for existing non-demo classes; class UUID -> course code.
# CLASS_COURSE_MAPPING={"replace-with-class-uuid":"CO2013"}

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=lms-backend
JWT_AUDIENCE=lms-frontend
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
# Additional trusted browser origins for Swagger on the API itself.
# Dev defaults to localhost/127.0.0.1 on PORT; set HTTPS origins for staging.
# AUTH_TRUSTED_ORIGINS=https://api.example.com

# Local demo seed only; set your own value (at least 12 characters).
# SEED_PASSWORD=

# Local Docker Compose only. Use different credentials for staging.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=15432

# B2: private S3-compatible bucket, pre-created by your storage administrator.
# No public bucket policy. Local MinIO: set endpoint and force path style.
# AWS can instead use its normal IAM role/provider chain (no static keys required).
# S3_BUCKET=lms-private
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# B2 upload protection, per authenticated user. Quota is shared through PostgreSQL.
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_MS=60000
UPLOAD_PENDING_MAX_FILES=20
UPLOAD_PENDING_MAX_BYTES=262144000
